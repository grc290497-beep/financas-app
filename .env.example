# Copy to .env.local and fill in from Supabase: Project Settings > API.

# Public (safe in the browser; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the app, used in links sent by email (signup confirmation,
# magic link). Production: https://financas-app-tau-bice.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix with NEXT_PUBLIC_ and never import in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
